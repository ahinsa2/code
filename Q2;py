s = "  Hello World! Hello Python!  "

print("Original string:", repr(s))
print("len():", len(s))
print("strip():", s.strip())
print("rstrip():", s.rstrip())
print("lstrip():", s.lstrip())
print("find('Hello'):", s.find("Hello"))
print("rfind('Hello'):", s.rfind("Hello"))
print("index('World'):", s.index("World"))
print("rindex('Hello'):", s.rindex("Hello"))
print("count('Hello'):", s.count("Hello"))
print("replace('Hello', 'Hi'):", s.replace("Hello", "Hi"))
print("split():", s.split())
print("join():", "-".join(['A', 'B', 'C']))
print("upper():", s.upper())
print("lower():", s.lower())
print("swapcase():", s.swapcase())
print("title():", s.title())
print("capitalize():", s.capitalize())
print("startswith('  H'):", s.startswith("  H"))
print("endswith('!  '):", s.endswith("!  "))
